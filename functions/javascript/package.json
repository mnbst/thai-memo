{
  "name": "thai-memo-functions",
  "version": "1.1.0",
  "description": "Cloud Functions for Thai Memo app",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "dev:batch": "curl -s https://asia-northeast1-thai-memo-dev.cloudfunctions.net/dailyBatch",
    "dev:notify": "curl -s https://asia-northeast1-thai-memo-dev.cloudfunctions.net/sendNotifications",
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --ext .js,.ts . --fix"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.0.1",
    "@google/generative-ai": "^0.24.1",
    "@types/nodemailer": "^7.0.11",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.1",
    "google-auth-library": "^9.0.0",
    "jose": "^5.0.0",
    "nodemailer": "^8.0.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
