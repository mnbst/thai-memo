rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // premium_trial_expires_at は体験の有効判定そのもの（体験中は課金プレミアムと
      // 同じ機能・回数が出る）。書けるとプレミアムを自己付与できるので必ず塞ぐ。
      // estimated_vocab は語彙ランキングの公開値そのもの（leaderboard/{uid} へ
      // サーバーが複製する）。書けると順位を自己申告できるので塞ぐ。
      // vocab_floor_applied は旧・下限の適用済み印。サーバーはもう書かないが、
      // クライアントに書かせる理由も無いので塞いだままにする。
      // vocab_test_at / vocab_test_vocab は語彙テストの測定結果、
      // vocab_test_window_at / vocab_test_count は受験間隔の記録。書けると制限を外して
      // estimated_vocab を任意の値まで釣り上げられるので塞ぐ。
      // lifetime_migration_eligible は無償買い切り移行のサーバー管理名簿。
      // 本人が立てられると migrateToLifetime の対象制限を回避できるので塞ぐ。
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['tier', 'daily_generation_count', 'daily_quiz_count', 'remaining_sentences', 'remaining_quizzes', 'premium_trial_remaining', 'premium_trial_expires_at', 'premium_trial_ended_at', 'lifetime_migration_eligible', 'estimated_vocab', 'vocab_floor_applied', 'vocab_test_at', 'vocab_test_vocab', 'vocab_test_count', 'vocab_test_window_at'])
        && (!request.resource.data.keys().hasAny(['vocab_floor'])
            || request.resource.data.vocab_floor in [0, 100, 300, 600]);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['tier', 'daily_generation_count', 'daily_quiz_count', 'last_generation_date', 'last_quiz_date', 'subscription', 'remaining_sentences', 'remaining_quizzes', 'premium_trial_remaining', 'premium_trial_expires_at', 'premium_trial_ended_at', 'lifetime_migration_eligible', 'last_sentence_generated_at', 'last_notified_at', 'estimated_vocab', 'vocab_floor_applied', 'vocab_test_at', 'vocab_test_vocab', 'vocab_test_count', 'vocab_test_window_at'])
        // vocab_floor は「申告レベルを語彙スコアの下限にする」旧仕様の名残。
        // サーバーはもう読まない（語彙スコアは語彙テストの測定値だけで決まる）。
        // 旧バージョンのアプリがヒアリング送信でこれを含めてくるので、書き込み
        // 自体は通す（拒否すると interview の記録ごと落ちる）。値の制限だけ
        // 残しておく。新しいクライアントは送らない。
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vocab_floor'])
            || request.resource.data.vocab_floor in [0, 100, 300, 600])
        // notify_tier / notify_tier_misses はサーバー管理だが、通知トグルON時の
        // バックオフ解除（0へのリセット）に限りクライアントから書ける
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['notify_tier', 'notify_tier_misses'])
            || (request.resource.data.notify_tier == 0
                && request.resource.data.notify_tier_misses == 0));

      match /sentences/{sentenceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // 本文はサーバーだけが書く。例外は既読フラグ（viewed）で、読んだ本人が
        // true にできる。まとめクイズが「まだ読んでいない例文」を出さないために
        // 要る。true への変更だけを通すので、既読を取り消して出題を避けることは
        // できない。
        //
        // お気に入り（favorite）と削除（deleted）も本人が書ける。ほかの端末へ
        // 伝えるためのもので、書くときは updated_at を更新時刻にする（差分同期の
        // カーソル）。削除は取り消せない。
        allow create, delete: if false;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['viewed'])
          && request.resource.data.viewed == true;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['favorite', 'deleted', 'updated_at'])
          && request.resource.data.updated_at == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['favorite'])
              || request.resource.data.favorite is bool)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleted'])
              || request.resource.data.deleted == true);
      }

      match /quiz_answers/{answerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 例文セットの進行位置。複数端末・再インストール後も続きを復元する。
      // 学習コンテンツや課金状態には影響せず、本人の状態だけを本人が更新できる。
      match /learning_state/{stateId} {
        // 別端末が読みかけのセット（正本の active）を、読み終えていないのに
        // 完了へ入れる書き込みか。
        //
        // 1.5.x までのクライアントは、待機列から溢れたセットを completed_set_ids に
        // 入れて送る。溢れたのが別端末の読みかけセットだと、全端末でその続きが
        // 消える。読み終えた端末なら最後の1本を既読にしているか、位置が最後の
        // 1本まで来ているので、どちらでもないものだけを拒む。
        //
        // 正本が3日動いていなければ通す。読んでいた端末をもう使っていない人
        // （機種変更）の同期を止め続けないため。
        function dropsUnfinishedActive() {
          let before = resource.data;
          let active = before.get('active', null);
          let ids = active == null ? [] : active.get('sentence_ids', []);
          let lastId = ids.size() > 0 ? ids[ids.size() - 1] : '';
          let lastPath = /databases/$(database)/documents/users/$(userId)/sentences/$(lastId);
          return lastId is string && lastId != ''
            && active.get('set_id', null) is string
            && request.resource.data.get('completed_set_ids', []).hasAny([active.set_id])
            && !before.get('completed_set_ids', []).hasAny([active.set_id])
            && before.get('active_sentence_id', null) != lastId
            && before.get('updated_at', null) is timestamp
            && before.updated_at > request.time - duration.value(3, 'd')
            && exists(lastPath)
            && get(lastPath).data.get('viewed', false) != true;
        }

        allow read: if request.auth != null
          && request.auth.uid == userId
          && stateId in ['daily_sets', 'summary_quiz', 'quiz_stats'];
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && stateId == 'daily_sets'
          && request.resource.data.keys().hasOnly([
            'active', 'active_index', 'active_sentence_id', 'pending',
            'completed_set_ids', 'updated_at'
          ])
          && (resource == null || !dropsUnfinishedActive());
        // まとめクイズの途中経過。別端末が同じセットの続きから解くため。
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && stateId == 'summary_quiz'
          && request.resource.data.keys().hasOnly(['set_id', 'quiz_json', 'updated_at'])
          && request.resource.data.set_id is string
          && request.resource.data.quiz_json is string
          && request.resource.data.quiz_json.size() < 200000;
        // クイズの累積統計（総回答数・正解数・連続日数）。端末間で共有する。
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && stateId == 'quiz_stats'
          && request.resource.data.keys().hasOnly([
            'total_answered', 'total_correct', 'current_streak', 'best_streak',
            'last_quiz_date', 'updated_at'
          ])
          && request.resource.data.total_answered is int
          && request.resource.data.total_correct is int
          && request.resource.data.current_streak is int
          && request.resource.data.best_streak is int
          && (request.resource.data.last_quiz_date == null
              || request.resource.data.last_quiz_date is string);
      }

      // UVM (User Vocabulary Model): read only, writes by Cloud Functions only
      match /uvm/{word} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // ランキング（語彙スコア）。users/{uid} は本人しか読めないので公開用に分ける。
    // 公開されるのは nickname と vocab だけ。どちらも Cloud Functions が書く。
    // 表示名は自動採番でユーザーは入力しないため、クライアント書き込みは全面禁止。
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 表示名の重複防止。小文字化した名前を doc ID にして押さえる。
    // Admin SDK の create（＝既存なら AlreadyExists）で一意性を担保する。
    match /nicknames/{nameKey} {
      allow read, write: if false;
    }

    // Quiz queue: users can read their own data, update sent field only
    match /quiz_queue/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent']);
    }

    // 生成例文の品質監査ログ（dailyBatch が書く）。プロンプト改善の資料であって
    // ユーザーに見せるものではない。他人の例文本文が入るので read も塞ぐ。
    match /sentence_flags/{flagId} {
      allow read, write: if false;
    }

    // 意味4択の単語解説キャッシュ（generateLearningQuiz が書く）。全ユーザー共有で
    // 個人情報は入らないが、読み書きはサーバー（Admin SDK）だけに限る。
    match /word_explanations/{wordKey} {
      allow read, write: if false;
    }

    // Legacy: notification_queue managed by Cloud Functions only
    match /notification_queue/{docId} {
      allow read, write: if false;
    }
  }
}
