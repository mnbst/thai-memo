rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['tier', 'daily_generation_count', 'daily_quiz_count']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['tier', 'daily_generation_count', 'daily_quiz_count', 'last_generation_date', 'last_quiz_date', 'subscription']);

      match /sentences/{sentenceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /quiz_answers/{answerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // UVM (User Vocabulary Model): read only, writes by Cloud Functions only
      match /uvm/{word} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Quiz queue: users can read their own data, update sent field only
    match /quiz_queue/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent']);
    }

    // Review queue: users can read their own data, update sent field only
    match /review_queue/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent']);
    }

    // Legacy: notification_queue managed by Cloud Functions only
    match /notification_queue/{docId} {
      allow read, write: if false;
    }
  }
}
