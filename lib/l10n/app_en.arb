  "toneMidDesc": "A tone whose pitch stays flat and doesn't change.",
  "toneMidExample": "กา (gaa) crow",
  "toneLowDesc": "A tone that starts low and falls slightly.",
  "toneLowExample": "ก่า (gàa) galangal",
  "toneFallingDesc": "A tone that drops from high to low.",
  "toneFallingExample": "ก้า (gâa) step",
  "toneHighDesc": "A tone that starts high and rises further.",
  "toneHighExample": "ก๊า (gáa) sentence-final particle",
  "toneRisingDesc": "A tone that rises from low to high.",
  "toneRisingExample": "ก๋า (gǎa) sentence-final particle",
  "toneMarkMaiEkDesc": "The first tone mark. The tone it produces depends on the consonant class.",
  "toneMarkMaiThoDesc": "The second tone mark. The tone it produces depends on the consonant class.",
  "toneMarkMaiTriDesc": "The third tone mark. Used with mid-class consonants; rare with low- or high-class ones.",
  "toneMarkMaiChattawaDesc": "The fourth tone mark. Used with mid-class consonants; rare with low- or high-class ones.",
  "tipCatVowel": "Vowels",
  "tipCatCulture": "Culture",
  "tipCatTone": "Tones",
  "tipCatConsonant": "Consonants",
  "tipCatNumber": "Numbers",
  "tipCatDaily": "Everyday phrases",
  "tipCatStudy": "Study tips",
  "tip_vowelA_title": "อะ / อา (a / aa)",
  "tip_vowelA_content": "Short อะ is \"a\"; long อา is \"aa\". Length alone changes the meaning.",
  "tip_vowelA_example": "จะ (jà = will) / จา (jaa = plate)",
  "tip_vowelI_title": "อิ / อี (i / ii)",
  "tip_vowelI_content": "Short อิ is a clipped \"i\"; long อี is a drawn-out \"ii\".",
  "tip_vowelI_example": "นิด (nít = a little) / นี่ (nîi = this)",
  "tip_vowelU_title": "อุ / อู (u / uu)",
  "tip_vowelU_content": "Short อุ is a clipped \"u\"; long อู is a drawn-out \"uu\".",
  "tip_vowelU_example": "รุ่น (rûn = generation) / รู้ (rúu = to know)",
  "tip_vowelE_title": "เอ / แอ (ee / ɛɛ)",
  "tip_vowelE_content": "เอ is \"ee\"; แอ is \"ɛɛ\", with your mouth open wider.",
  "tip_vowelE_example": "เก่ง (kèeng = skilled) / แก่ (kɛ̀ɛ = old)",
  "tip_vowelO_title": "โอ / ออ (oo / ɔɔ)",
  "tip_vowelO_content": "โอ is a rounded \"oo\"; ออ is an open \"ɔɔ\".",
  "tip_vowelO_example": "โต (too = big) / ต่อ (tɔ̀ɔ = to continue)",
  "tip_vowelUea_title": "เอือ (ʉa)",
  "tip_vowelUea_content": "เอือ has no English equivalent. It's written \"ʉa\".",
  "tip_vowelUea_example": "เมือง (mʉʉang = city, country)",
  "tip_vowelUu_title": "อือ / อื (ʉ / ʉʉ)",
  "tip_vowelUu_content": "No English equivalent: shape your mouth for \"i\" but say \"u\".",
  "tip_vowelUu_example": "คือ (khʉʉ = to be) / ฝืน (fʉ̌ʉn = to force oneself)",
  "tip_vowelIa_title": "เอีย (ia)",
  "tip_vowelIa_content": "เอีย is \"ia\" — glide smoothly from i to a.",
  "tip_vowelIa_example": "เรียน (riian = to study)",
  "tip_vowelUa_title": "อัว (ua)",
  "tip_vowelUa_content": "อัว is \"ua\" — glide smoothly from u to a.",
  "tip_vowelUa_example": "ตัว (tuua = body, classifier for animals)",
  "tip_vowelAw_title": "เอา (aw)",
  "tip_vowelAw_content": "เอา is \"aw\": start open, then round your lips.",
  "tip_vowelAw_example": "เอา (aw = to want, to take)",
  "tip_vowelAi_title": "ไอ / ใอ (ai)",
  "tip_vowelAi_content": "ไอ and ใอ sound identical. Only 20 words use ใ.",
  "tip_vowelAi_example": "ไป (pai = to go) / ใจ (jai = heart)",
  "tip_vowelShortE_title": "เอ็ (short e)",
  "tip_vowelShortE_content": "A clipped \"e\", written in the เ〜็ shape.",
  "tip_vowelShortE_example": "เก็บ (kèp = to pick up, to keep)",
  "tip_vowelShortAe_title": "แอ็ (short ɛ)",
  "tip_vowelShortAe_content": "A clipped \"ɛ\" with the mouth wide open, in the แ〜็ shape.",
  "tip_vowelShortAe_example": "แบ็ก (bɛ̀k = bag)",
  "tip_vowelOe_title": "เออ (əə)",
  "tip_vowelOe_content": "เออ is the neutral vowel \"əə\". Keep your mouth half open.",
  "tip_vowelOe_example": "เธอ (thəə = you, she)",
  "tip_vowelLength_title": "Vowel length changes meaning",
  "tip_vowelLength_content": "Length matters in Thai: a short vowel and a long one are different words.",
  "tip_vowelLength_example": "ปะ (pà = to meet) / ป้า (pâa = aunt)",
  "tip_cultureWai_title": "wâi (ไหว้)",
  "tip_cultureWai_content": "The Thai greeting: palms together. Raise them to your nose for elders, to your chest for peers.",
  "tip_cultureTemple_title": "Temple etiquette",
  "tip_cultureTemple_content": "Take off your shoes and cover your shoulders and knees. Never sit higher than a Buddha image.",
  "tip_cultureSongkran_title": "sǒngkraan (water festival)",
  "tip_cultureSongkran_content": "Thai New Year, 13–15 April. People splash water on each other to celebrate.",
  "tip_cultureLoyKrathong_title": "lɔɔi krathong (floating lanterns)",
  "tip_cultureLoyKrathong_content": "On the full moon of the 12th lunar month, people float lanterns down the river to thank the water spirits.",
  "tip_cultureEating_title": "How Thai food is eaten",
  "tip_cultureEating_content": "Eat with the spoon and use the fork to push food onto it. Chopsticks are mainly for noodles.",
  "tip_cultureMaiPenRai_title": "ไม่เป็นไร (mâi pen rai)",
  "tip_cultureMaiPenRai_content": "Means “don't worry” or “it's fine.” It's one of the most common Thai expressions.",
  "tip_toneFive_title": "Thai has five tones",
  "tip_toneFive_content": "Mid, low, falling, high, and rising. Change the tone and you have a different word.",
  "tip_toneFive_example": "ไหม (mǎi = silk) / ใหม่ (mài = new) / ไม่ (mâi = not)",
  "tip_toneMaiEk_title": "Tone mark ่ (mái èek)",
  "tip_toneMaiEk_content": "The first tone mark, written above the letter. On mid- and high-class consonants it gives a low tone.",
  "tip_toneMaiEk_example": "เก่า (kàw = old), ข่าว (khàaw = news)",
  "tip_toneMaiTho_title": "Tone mark ้ (mái thoo)",
  "tip_toneMaiTho_content": "The second tone mark. On a mid-class consonant it gives a falling tone.",
  "tip_toneMaiTho_example": "น้ำ (náam = water), บ้าน (bâan = house)",
  "tip_toneMaiTriChat_title": "Tone marks ๊ and ๋",
  "tip_toneMaiTriChat_content": "๊ (mái trii) marks a high tone, ๋ (mái jàttawaa) a rising one. Both are uncommon.",
  "tip_toneMaiTriChat_example": "โน๊ต (nóot = note), จ๋า (jǎa = yes?)",
  "tip_toneClassRelation_title": "Consonant class and tone",
  "tip_toneClassRelation_content": "The tone comes from the consonant class (high, mid, low), vowel length, final consonant, and tone mark together.",
  "tip_toneMistake_title": "Get the tone wrong and…",
  "tip_toneMistake_content": "สวย (sǔuai = beautiful) and ซวย (suuai = unlucky): the tone changes the meaning completely.",
  "tip_toneMidExplain_title": "Mid tone (sǎa-man)",
  "tip_toneMidExplain_content": "Flat, at your normal pitch. The default for a mid-class consonant with a long vowel and no tone mark.",
  "tip_toneMidExplain_example": "กา (kaa = crow), ดี (dii = good)",
  "tip_toneRisingExplain_title": "Rising tone (jàttawaa)",
  "tip_toneRisingExplain_content": "Starts low and climbs — a bit like the way a question rises in English.",
  "tip_toneRisingExplain_example": "สวย (sǔuai = beautiful), หนาว (nǎaw = cold)",
  "tip_toneRelative_title": "Tone is relative",
  "tip_toneRelative_content": "How high a tone sounds depends on the syllable before it, so learn whole phrases rather than isolated words.",
  "tip_consonant44_title": "Thai has 44 consonants",
  "tip_consonant44_content": "44 letters, of which 42 are still in use — but they cover only 21 distinct sounds.",
  "tip_consonantHigh_title": "High class (àksɔ̌ɔn sǔung)",
  "tip_consonantHigh_content": "The 11 letters ข ฃ ฉ ฐ ถ ผ ฝ ศ ษ ส ห. Their tone rules differ from mid- and low-class ones.",
  "tip_consonantMid_title": "Mid class (àksɔ̌ɔn klaang)",
  "tip_consonantMid_content": "The 9 letters ก จ ฎ ฏ ด ต บ ป อ. Tone marks follow their basic pattern in this group.",
  "tip_consonantLow_title": "Low class (àksɔ̌ɔn tàm)",
  "tip_consonantLow_content": "The remaining 24 letters. Some pair with high-class letters; others stand alone.",
  "tip_consonantFinal_title": "Final consonant rules",
  "tip_consonantFinal_content": "Only 8 sounds can end a syllable: k, t, p, n, m, ng, i, o. A letter often changes sound in final position.",
  "tip_consonantFinal_example": "บ, ป, พ, ภ, ฟ all become -p at the end of a syllable",
  "tip_consonantAspiration_title": "Aspirated and unaspirated",
  "tip_consonantAspiration_content": "Thai distinguishes consonants by the puff of air. ป (unaspirated p) and พ (aspirated ph) are different sounds.",
  "tip_consonantAspiration_example": "ปลา (plaa = fish) / พลา (phlaa = to fail)",
  "tip_consonantSilent_title": "The silent mark ์ (kaa-ran)",
  "tip_consonantSilent_content": "A ์ above a letter means \"don't pronounce this one\". Common in loanwords.",
  "tip_consonantSilent_example": "จันทร์ (jan = moon) — the ร์ is silent",
  "tip_consonantCluster_title": "Clusters (àksɔ̌ɔn khûap)",
  "tip_consonantCluster_content": "Two consonants in a row are pronounced together: kr, kl, pr, pl, and so on.",
  "tip_consonantCluster_example": "กรุง (krung = capital) / ปลา (plaa = fish)",
  "tip_numberThai_title": "Thai numerals",
  "tip_numberThai_content": "Thai has its own digits: ๐๑๒๓๔๕๖๗๘๙ (0–9). You'll see them on signs and official documents.",
  "tip_number1to5_title": "Counting 1 to 5",
  "tip_number1to5_content": "๑ nʉ̀ng, ๒ sɔ̌ɔng, ๓ sǎam, ๔ sìi, ๕ hâa",
  "tip_number6to10_title": "Counting 6 to 10",
  "tip_number6to10_content": "๖ hòk, ๗ jèt, ๘ pɛ̀ɛt, ๙ kâw, ๑๐ sìp",
  "tip_number11and21_title": "11 and 21 are special",
  "tip_number11and21_content": "11 is sìp èt and 21 is yîi sìp èt — both the ones digit and the twenties are irregular.",
  "tip_numberClassifier_title": "Classifiers (láksanànaam)",
  "tip_numberClassifier_content": "Thai uses a number plus a classifier, similar to “two sheets of paper” in English.",
  "tip_numberClassifier_example": "khon (people), tua (animals), an (small objects)",
  "tip_numberBig_title": "Hundreds and thousands",
  "tip_numberBig_content": "rɔ́ɔi (hundred), phan (thousand), mʉ̀ʉn (ten thousand), sǎen (hundred thousand), láan (million)",
  "tip_numberPrice_title": "Asking the price",
  "tip_numberPrice_content": "\"How much is it?\" is thâo rài. Learn it alongside raakhaa (price).",
  "tip_numberPrice_example": "an-níi thâo rài (how much is this?)",
  "tip_dailyPolite_title": "ครับ / ค่ะ (khráp / khâ)",
  "tip_dailyPolite_content": "Men add khráp and women add khâ to the end of sentences to sound polite.",
  "tip_dailyPolite_example": "khɔ̀ɔp khun khráp / khɔ̀ɔp khun khâ",
  "tip_dailyHello_title": "สวัสดี (sà-wàt-dii)",
  "tip_dailyHello_content": "\"Hello\" — works any time of day, and on the way out too.",
  "tip_dailyThanks_title": "ขอบคุณ (khɔ̀ɔp khun)",
  "tip_dailyThanks_content": "\"Thank you.\" Add mâak for \"thank you very much\".",
  "tip_dailySorry_title": "ขอโทษ (khɔ̌ɔ thôot)",
  "tip_dailySorry_content": "Means \"sorry\" or \"excuse me.\" Use it to apologize or get someone's attention.",
  "tip_dailyYesNo_title": "ใช่ / ไม่ใช่ (châi / mâi châi)",
  "tip_dailyYesNo_content": "Means \"yes\" and \"no\" when confirming whether something is correct.",
  "tip_dailyYesNo_example": "châi mǎi (is that right?) → châi khráp (yes)",
  "tip_dailyEat_title": "กิน (kin) = to eat",
  "tip_dailyEat_content": "\"Have you eaten?\" — kin khâao rʉ̌ʉ yang — is a standard Thai greeting.",
  "tip_dailyDelicious_title": "อร่อย (à-ròi) = delicious",
  "tip_dailyDelicious_content": "Say à-ròi after a good meal. Add mâak and it's \"really delicious\".",
  "tip_dailyPronouns_title": "Choosing a pronoun",
  "tip_dailyPronouns_content": "phǒm is the formal \"I\" for men, dì-chǎn for women.",
  "tip_dailyPronouns_example": "Casually, rao and chǎn are common too",
  "tip_studyThaiOnly_title": "Take the quiz using only Thai",
  "tip_studyThaiOnly_content": "Try answering from the Thai alone, without checking the sentence or notes.",

